# Vista — your wallpaper picker. Package from the flake input (via overlay → pkgs.vista).
# Vista OWNS the live wallpaper. Stylix's feh target is off (theme/home.nix); i3 restores ~/.fehbg on login.
#
# Keys below match config/vista.conf.example in the vista repo. Vista has no colour keys —
# its shader glow is image-adaptive — so the only theme coupling is: palette generators OFF.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  pictures = "${config.home.homeDirectory}/Pictures/Wallpapers";

  vistaConf = {
    wallpaper_dir = pictures;
    wallpaper_dir_1 = "${pictures}/lambda"; # wallpapers tracked in this repo (symlinked below)

    feh_command = "feh --bg-fill"; # feh is on vista's PATH via wrapProgram (vista-flake/nix/package.nix)
    use_per_monitor = false;

    # Stylix is the palette. Two generators would fight.
    use_wal = false;
    reload_i3 = false;
    use_openrgb = false;

    thumbnail_width = 200;
    thumbnail_height = 150;
    thumbnails_per_row = 5;
    window_width = 1200;
    window_height = 300;

    # Needs a GL-capable compositor. Off in the VM; flip on bare metal (picom backend → glx too).
    use_shaders = false;
  };
in
{
  home.packages = [ pkgs.vista ];

  xdg.configFile."vista/vista.conf".text = ''
    # Generated by Lambda (modules/home/vista.nix). Edit that file, not this one.
  ''
  + lib.generators.toKeyValue {
    mkKeyValue = lib.generators.mkKeyValueDefault { } " = ";
  } vistaConf;

  # Repo wallpapers show up in Vista under ~/Pictures/Wallpapers/lambda/
  home.file."Pictures/Wallpapers/lambda".source = ../../theme/wallpapers;

  lambda.wallpaperPicker = "vista";
}
