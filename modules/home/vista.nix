# Vista — your wallpaper picker. Package from the flake input (via overlay → pkgs.vista).
# Vista OWNS the live wallpaper. Stylix's feh target is off (theme/home.nix); i3 restores ~/.fehbg on login.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  colors = config.lib.stylix.colors.withHashtag;
  fonts = config.stylix.fonts;
  wallpaperDir = "${config.home.homeDirectory}/Pictures/Wallpapers";

  # TODO: match these keys to what src/config.c actually parses.
  # Values are right; only the key names may differ.
  vistaConfig = {
    wallpaper_dir = wallpaperDir;
    feh_command = "feh --bg-fill"; # feh is on vista's PATH via wrapProgram (see vista flake)
    palette_script = ""; # EMPTY ON PURPOSE — Stylix is the palette now; two generators would fight
    thumbnail_size = 200;

    background = colors.base00;
    foreground = colors.base05;
    selected = colors.base0D;
    border = colors.base02;
    font = fonts.monospace.name;
    font_size = fonts.sizes.popups;
  };
in
{
  home.packages = [ pkgs.vista ];

  xdg.configFile."vista/config".text = ''
    # Generated by Lambda (modules/home/vista.nix). Edit theme/half-life.yaml, not this file.
  ''
  + lib.generators.toKeyValue {
    mkKeyValue = lib.generators.mkKeyValueDefault { } " = ";
  } vistaConfig;

  # Wallpapers tracked in the repo show up in Vista under ~/Pictures/Wallpapers/lambda/
  home.file."Pictures/Wallpapers/lambda".source = ../../theme/wallpapers;
}
